# FastAPI Backend (.env.example)
# Copy to .env and set values for local development or deployment.

# CORS: Comma-separated list of allowed origins.
# For local dev:
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:3000

# Supabase (Server-side; DO NOT expose service role to frontend)
# Optional if backend needs to interact with Supabase using service role.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Site URL if backend constructs absolute redirect links (not required currently)
SITE_URL=http://localhost:3000
